        <script><![CDATA[
if (GenerateAndSendStakeholderInvitation(current) == true)
{
	gs.addInfoMessage(
		'An invitation has been sent to the stakeholder.');
}
else
{
	var strMessage = GenerateStakeholderInvitation(current);
	if (strMessage != false)
	{
		gs.addInfoMessage(
			x_snc_devtools.HtmlEncode(
				'Please share this message with the stakeholder:\n\n'+strMessage));
	}
	else
	{
		gs.addErrorMessage('An error occured. The invitation message could not be created. Make sure a consultant is selected.');
	}
}

x_snc_devtools.RedirectToRecord(current);]]></script>
