        <order>100</order>
        <script><![CDATA[function onClickStartInterview()
{
	var strTitle = 'Agentic Business Process Consultant';
	
	function StateStart()
	{
		var strBusinessProcessSysId = GetCurrentRecordSysId();

		ServerRequest(
			'x_snc_agenticbpc.AgenticBusinessProcessConsultantClientAPI',
			'StartInterview',
			{
				business_process_sys_id: strBusinessProcessSysId
			},StateResponse);	
	}
	
	function StateResponse(strConversationSysId)
	{
		if (strConversationSysId == false)
		{
			DoModalMessage(strTitle,'Failed to start interview.',StateFinish);
		}
		else
		{
			ShowNowAssistPanel(strConversationSysId);
		} 
	}
	
	function StateFinish()
	{}
	
	StateStart();
	//DoModalMessage('Agentic BPC','Start Interview?',function() {});
	//ShowNowAssistPanel();
}]]></script>
